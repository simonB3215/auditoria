# Servidor
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=change-me
SUPABASE_SERVICE_ROLE_KEY=change-me
SUPABASE_JWT_SECRET=change-me

# Redis (para BullMQ - motor de escaneo asíncrono)
REDIS_URL=redis://localhost:6379

# Storage
EVIDENCE_BUCKET=evidences
REPORTS_BUCKET=reports
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EVIDENCE_ENCRYPTION_KEY=change-me-64-hex-chars
