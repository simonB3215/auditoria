# Servidor
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase — Project Settings > API Keys
# https://supabase.com/dashboard/project/_/settings/api-keys
SUPABASE_URL=https://xxxxx.supabase.co
# Publishable key (sb_publishable_...). Si tu proyecto es viejo y todavía
# no migró, también funciona la "anon key" legacy (pestaña "Legacy API Keys").
SUPABASE_ANON_KEY=change-me
# Secret key (sb_secret_...), o la "service_role key" legacy. NUNCA exponer
# esta al frontend ni a un NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=change-me

# Postgres — Project Settings > Database > Connection string > URI
# (conexión directa, puerto 5432; reemplazar [YOUR-PASSWORD] por el password real)
# Solo la usa `npm run db:migrate` para aplicar db/schema.sql y las migraciones.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# Redis (para BullMQ - motor de escaneo asíncrono)
REDIS_URL=redis://localhost:6379

# Storage
EVIDENCE_BUCKET=evidences
REPORTS_BUCKET=reports
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EVIDENCE_ENCRYPTION_KEY=change-me-64-hex-chars
