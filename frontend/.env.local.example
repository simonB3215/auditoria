# Supabase (mismo proyecto que usa el backend) — Project Settings > API Keys
# https://supabase.com/dashboard/project/_/settings/api-keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# Publishable key (sb_publishable_...) o, en proyectos viejos, la anon key
# legacy (pestaña "Legacy API Keys"). NUNCA poner acá la secret/service_role key:
# todo lo que empieza con NEXT_PUBLIC_ termina en el JS que se manda al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=change-me

# URL del backend Express (ver ../src/server.ts)
NEXT_PUBLIC_API_URL=http://localhost:3000
