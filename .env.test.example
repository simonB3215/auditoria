# Variables para correr `npm test`.
#
# IMPORTANTE: usar un proyecto Supabase DEDICADO a testing, nunca el de
# desarrollo/producción. Los tests crean y BORRAN usuarios, organizaciones,
# activos y auditorías reales (ver tests/helpers/tenants.ts).
#
# Copiar a .env.test y completar con los datos del proyecto de test.

PORT=3000
NODE_ENV=test
CORS_ORIGIN=http://localhost:5173

# Project Settings > API Keys (https://supabase.com/dashboard/project/_/settings/api-keys)
SUPABASE_URL=https://xxxxx-test.supabase.co
# Publishable key (sb_publishable_...) o la anon key legacy.
SUPABASE_ANON_KEY=change-me
# Secret key (sb_secret_...) o la service_role key legacy.
SUPABASE_SERVICE_ROLE_KEY=change-me

# Redis real (puede ser local: `docker run -p 6379:6379 redis`).
# Requerido por TC-10 (encolado real de un job de escaneo).
REDIS_URL=redis://localhost:6379

EVIDENCE_BUCKET=evidences
REPORTS_BUCKET=reports
EVIDENCE_ENCRYPTION_KEY=generar-con-node-crypto-randomBytes-32-hex
