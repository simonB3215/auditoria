# Variables para correr `npm test`.
#
# IMPORTANTE: usar un proyecto Supabase DEDICADO a testing, nunca el de
# desarrollo/producción. Los tests crean y BORRAN usuarios, organizaciones,
# activos y auditorías reales (ver tests/helpers/tenants.ts).
#
# Copiar a .env.test y completar con los datos del proyecto de test. Fuente
# de verdad de qué es obligatorio: src/config/env.ts (schema de Zod).

PORT=3000
NODE_ENV=test
CORS_ORIGIN=http://localhost:3001

# --- Supabase — Project Settings > API Keys ---
# https://supabase.com/dashboard/project/_/settings/api-keys
SUPABASE_URL=https://xxxxx-test.supabase.co
# Publishable key (sb_publishable_...) o la anon key legacy.
SUPABASE_ANON_KEY=change-me
# Secret key (sb_secret_...) o la service_role key legacy.
SUPABASE_SERVICE_ROLE_KEY=change-me

# --- Postgres — Project Settings > Database > Connection string > URI ---
# Solo la usa `npm run db:migrate` contra el proyecto de test; no forma
# parte del schema de Zod.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxx-test.supabase.co:5432/postgres

# --- Redis real (puede ser local: `docker run -p 6379:6379 redis`) ---
# Requerido por los tests de encolado real de un job de escaneo.
REDIS_URL=redis://localhost:6379

# --- Storage ---
EVIDENCE_BUCKET=evidences
REPORTS_BUCKET=reports
# Clave AES-256 (32 bytes) en hex — SOLO para tests, nunca reutilizar la de
# desarrollo/producción. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EVIDENCE_ENCRYPTION_KEY=change-me-64-hex-chars

# --- Reglas de negocio ---
# Opcional: si no se define, el default del schema es 5.
MAX_ASSETS_PER_ORG=5
# Opcional, default 2.
MAX_CONCURRENT_SCANS_PER_ORG=2
# Opcional, default 1000, tope máximo duro 5000.
SCAN_TOP_PORTS=1000

# --- Email transaccional (Resend) — OPCIONAL ---
# No forma parte del schema de Zod. Se puede omitir en test: el envío queda
# en modo "preparado pero no conectado" (se loguea en vez de enviarse).
RESEND_API_KEY=change-me
